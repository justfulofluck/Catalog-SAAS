# ─────────────────────────────────────────────────────────────
# Copy to `.env` (repo root) and fill in real values.
# `.env` is gitignored -- never commit real credentials.
#
#   cp .env.example .env
#
# Use a Gmail App Password here if the mailbox is a Google account:
#   https://myaccount.google.com/apppasswords
# Requires 2-Step Verification. Use the app password, NOT the account password.
# ─────────────────────────────────────────────────────────────

# ── Email (SMTP) ──────────────────────────────────────────────
# Leave EMAIL_HOST_USER / EMAIL_HOST_PASSWORD empty to disable real sending:
# the backend falls back to django.core.mail.backends.console.EmailBackend and
# prints emails to the terminal instead of failing.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# TLS (port 587) or SSL (port 465) -- set exactly one to true.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Seconds before an SMTP connection is aborted.
EMAIL_TIMEOUT=10

# The address outgoing mail is sent from. Should match EMAIL_HOST_USER unless
# the provider gives you a dedicated sending domain. Defaults to
# EMAIL_HOST_USER when left empty. Must be set to a real address -- a
# `webmaster@localhost` From header causes providers to reject or spam the mail.
DEFAULT_FROM_EMAIL=

# ── Frontend ──────────────────────────────────────────────────
# Public URL of the React app. Used to build links inside emails, e.g. the
# dashboard link in the welcome email. Must NOT be left at localhost in
# production or emails will link to a dead address.
FRONTEND_URL=http://localhost:3000