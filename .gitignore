# ──────────────────────── Uploaded Media & Exports ───────────────
# NOTE: The Django `media` app source code lives directly in
# MEDIA_ROOT (backend/media/). Uploaded files are stored as
# <business_name>/... subfolders. Ignore all upload content but keep
# the app source files and its migrations.
backend/media/*
!backend/media/__init__.py
!backend/media/admin.py
!backend/media/apps.py
!backend/media/models.py
!backend/media/serializers.py
!backend/media/urls.py
!backend/media/views.py
!backend/media/tests.py
!backend/media/migrations/
!backend/media/migrations/__init__.py
!backend/media/migrations/*.py

# Exports / PDFs
exports/
backend/exports/
frontend/exports/
*.pdf

